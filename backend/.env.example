APP_NAME="SMS App"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_DATABASE=/absolute/path/to/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
CACHE_STORE=database
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Reverb socket server. APP_KEY below must match the frontend's VITE_REVERB_APP_KEY.
# Generate random values, e.g.: php artisan key:generate --show
REVERB_APP_ID=sms-app
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_APP_NAME="${APP_NAME}"

# Dynalink NS-API. Client id/secret and webhook URL can also be set later
# in the superadmin portal (portal values override these).
DYNALINK_CORE_BASE=https://core2-nyc.dynalink.net/ns-api/v2
DYNALINK_AUTH_BASE=https://nms1.nyc.birns.net/ns-api/v2
DYNALINK_CLIENT_ID=report
DYNALINK_CLIENT_SECRET=
DYNALINK_SERVICE_USER=
DYNALINK_SERVICE_PASS=
DYNALINK_WEBHOOK_URL=

# Rev.io integration. Leave verification ON unless local testing proves the
# machine can't verify TLS (then set false temporarily — never in production).
#REVIO_VERIFY_SSL=false
