{
    "name": "sms-app/backend",
    "type": "project",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/reverb": "^1.11",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^3.0",
        "minishlink/web-push": "^9.0"
    },
    "require-dev": {
        "laravel/pint": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "scripts": {
        "dev": "php artisan serve & php artisan queue:work & php artisan reverb:start"
    }
}
