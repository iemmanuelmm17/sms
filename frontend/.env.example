# Backend origin for API calls. "/" goes through the Vite proxy (recommended —
# no CORS setup needed). A full URL (http://HOST:8000) also works but needs
# CORS + session-domain config on the backend.
# WARNING: if this is empty/unset the app boots in DEMO mode (mock data).
VITE_API_URL=/

# Where the Vite proxy forwards /api + /broadcasting (dev server only).
VITE_API_PROXY=http://localhost:8000

# Hosts allowed to reach the Vite dev server (comma-separated, no spaces).
# Add this machine's LAN IP/hostname so other devices can open the app.
# Example: VITE_ALLOWED_HOSTS=192.168.1.5,myserver
VITE_ALLOWED_HOSTS=

# Reverb socket server the BROWSER connects to. Use this machine's LAN IP
# when accessing from other devices. KEY must match backend REVERB_APP_KEY.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Only needed behind an https preview proxy (sandbox use). Leave unset on LAN.
# VITE_HMR_CLIENT_PORT=443
